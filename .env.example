# Copy this file to .env and fill values locally.
# Do not commit .env.

# Oracle AI Database configuration.
ORACLE_AI_DB_USER=
ORACLE_AI_DB_PASSWORD=
ORACLE_AI_DB_DSN=

# Agent LLM configuration.
GENAI_PROVIDER=
GENAI_MODEL=
GENAI_API_KEY=
GENAI_ENDPOINT=

# Memory embedding configuration.
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_ENDPOINT=

# Optional embedding request parameters.
# Leave blank unless your embedding endpoint requires them.
EMBEDDING_ENCODING_FORMAT=
EMBEDDING_INPUT_TYPE=

# Optional split input types for asymmetric embedding models.
# Use these when query and stored-document embeddings need different values.
EMBEDDING_QUERY_INPUT_TYPE=
EMBEDDING_DOCUMENT_INPUT_TYPE=

# Optional table prefix config.
ORACLE_SESSION_TABLE_PREFIX=ADK
ORACLE_MEMORY_TABLE_PREFIX=ADK_MEMORY
ORACLE_ARTIFACT_TABLE_PREFIX=ADK
